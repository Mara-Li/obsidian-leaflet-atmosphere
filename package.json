{
	"name": "gazette",
	"version": "1.0.0",
	"description": "Publish your notes to Leaflet, the AT Protocol blogging platform.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"prebuild": "tsc --noEmit --skipLibCheck",
		"build": "node esbuild.config.mjs --production",
		"dev:prod": "node esbuild.config.mjs --vault",
		"dev": "node esbuild.config.mjs",
		"export": "node esbuild.config.mjs --production --vault",
		"bump": "dotenv -- node commit-and-tag-version.mjs",
		"postbump": "dotenv -- if-env SKIP_POST_BUMP=true && echo skip bump || git push --follow-tags origin master",
		"predeploy": "pnpm run bump",
		"deploy": "pnpm run export",
		"lint": "eslint .",
		"format": "biome format --write src/",
		"e2e": "pnpm run build && pnpm --filter gazette-e2e run e2e"
	},
	"engines": {
		"node": "^26"
	},
	"keywords": [],
	"author": "Mara-Li",
	"license": "GPL-3.0-or-later",
	"devDependencies": {
		"@biomejs/biome": "^2.0.0-beta.5",
		"@delucis/if-env": "^1.1.2",
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.2.13",
		"@types/node": "^26.6.6",
		"ansi-colors": "^4.1.3",
		"commander": "^15.1.0",
		"commit-and-tag-version": "^13.3.0",
		"dedent": "^1.5.3",
		"dotenv-cli": "^11.1.0",
		"esbuild": "0.28.2",
		"eslint": "^10.14.0",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"globals": "^17.6.0",
		"i18next": "^27.1.1",
		"jiti": "^2.6.1",
		"marked": "^18.2.0",
		"obsidian": "^1.8.7",
		"obsidian-typings": "^6.59.0",
		"preact": "^11.2.0",
		"tslib": "2.9.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.1"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"electron",
		"esbuild",
		"obsidian-typings"
	]
}
